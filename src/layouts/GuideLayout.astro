---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/guides";
import SiteLayout from "./SiteLayout.astro";

interface Props {
  guide: CollectionEntry<"blog">;
}

const { guide } = Astro.props;
const image = guide.data.leadImage;
---

<SiteLayout title={guide.data.meta.title} description={guide.data.meta.description}>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">{guide.data.category}</p>
      <h1>{guide.data.title}</h1>
      <p class="article-dek">{guide.data.dek}</p>
      <div class="article-meta">
        <span>{formatDate(guide.data.date)}</span>
        <span>{guide.data.readingMinutes} min read</span>
      </div>
    </header>
    {image && (
      <figure class="lead-figure">
        <img src={image.src} alt={image.alt} width="1586" height="992" loading="eager" />
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    )}
    <div class="article-grid">
      <aside class="article-aside" aria-label="Article details">
        <p class="aside-label">Dispatch</p>
        <p>{guide.data.category}</p>
        <p>{formatDate(guide.data.updated ?? guide.data.date)}</p>
      </aside>
      <div class="article-body">
        <slot />
      </div>
    </div>
  </article>
</SiteLayout>
