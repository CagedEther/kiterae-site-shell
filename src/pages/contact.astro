---
import { getEntry, render } from "astro:content";
import ContactForm from "../components/ContactForm.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const page = await getEntry("pages", "contact");
if (!page || page.data.template !== "page") throw new Error("Missing content/pages/contact.mdx");
const { Content } = await render(page);
---

<SiteLayout title={page.data.meta.title} description={page.data.meta.description}>
  <section class="index-header">
    <p class="eyebrow">{page.data.eyebrow}</p>
    <h1>{page.data.title}</h1>
    <p>{page.data.deck}</p>
  </section>
  <section class="page-grid contact-page">
    <div class="article-body contact-copy">
      <Content />
    </div>
    <ContactForm />
  </section>
</SiteLayout>
