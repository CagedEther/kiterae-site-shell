---
import { getCollection, getEntry, render } from "astro:content";
import GuideCard from "../components/GuideCard.astro";
import { formatDate, sortGuides } from "../lib/guides";
import SiteLayout from "../layouts/SiteLayout.astro";

const home = await getEntry("pages", "home");
if (!home || home.data.template !== "home") {
  throw new Error("Missing content/pages/home.mdx");
}
const { Content } = await render(home);

const guides = sortGuides(await getCollection("blog"));
const lead = guides.find((guide) => guide.data.featured === "lead") ?? guides[0];
const coreGuides = guides.filter((guide) => guide.data.featured === "core").slice(0, 2);
const moreGuides = guides.filter((guide) => guide.id !== lead.id && !coreGuides.some((core) => core.id === guide.id));
---

<SiteLayout title={home.data.meta.title} description={home.data.meta.description}>
  <section class="edition-strip">
    <p>{home.data.label}</p>
    <p>{home.data.topicLine}</p>
  </section>

  <section class="home-lede">
    <p class="eyebrow">{home.data.heroEyebrow}</p>
    <h1>{home.data.lede}</h1>
    <div class="home-intro-copy">
      <Content />
    </div>
  </section>

  <section class="lead-story">
    <a class="lead-link" href={`/guides/${lead.id}/`}>
      {lead.data.leadImage && (
        <div class="lead-image-wrap">
          <img src={lead.data.leadImage.src} alt={lead.data.leadImage.alt} width="1586" height="992" />
        </div>
      )}
      <div class="lead-copy">
        <p class="eyebrow">{lead.data.category}</p>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.dek}</p>
        <div class="article-meta">
          <span>{formatDate(lead.data.date)}</span>
        </div>
        <span class="text-link">Read the guide</span>
      </div>
    </a>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">{home.data.coreEyebrow}</p>
      <h2>{home.data.coreHeading}</h2>
      <p>{home.data.coreDeck}</p>
    </div>
    <div class="core-grid">
      {coreGuides.map((guide) => <GuideCard guide={guide} size="large" />)}
    </div>
  </section>

  <section class="section-block more-guides">
    <div class="rule"></div>
    <div class="section-heading section-heading-row">
      <p class="eyebrow">{home.data.moreHeading}</p>
      <a class="text-link" href="/guides/">All guides</a>
    </div>
    <div class="guide-grid">
      {moreGuides.map((guide) => <GuideCard guide={guide} />)}
    </div>
  </section>
</SiteLayout>
